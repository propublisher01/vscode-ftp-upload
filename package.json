{
  "name": "ftp-upload-on-save",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.1",
  "publisher": "proPublisher",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "ftps",
    "sftp",
    "upload",
    "deploy",
    "sync"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/propublisher01/vscode-ftp-upload.git"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "ftpUpload.syncAll",
        "title": "%command.syncAll.title%"
      },
      {
        "command": "ftpUpload.toggleAutoUpload",
        "title": "%command.toggleAutoUpload.title%"
      },
      {
        "command": "ftpUpload.testConnection",
        "title": "%command.testConnection.title%"
      },
      {
        "command": "ftpUpload.resetPassword",
        "title": "%command.resetPassword.title%"
      },
      {
        "command": "ftpUpload.configureFolder",
        "title": "%command.configureFolder.title%"
      },
      {
        "command": "ftpUpload.refreshRemoteFiles",
        "title": "%command.refreshRemoteFiles.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "ftpUpload.openRemoteFile",
        "title": "%command.openRemoteFile.title%"
      },
      {
        "command": "ftpUpload.downloadRemote",
        "title": "%command.downloadRemote.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ftpUpload.deleteRemote",
        "title": "%command.deleteRemote.title%",
        "icon": "$(trash)"
      },
      {
        "command": "ftpUpload.downloadFromServer",
        "title": "%command.downloadFromServer.title%"
      },
      {
        "command": "ftpUpload.uploadToServer",
        "title": "%command.uploadToServer.title%"
      }
    ],
    "submenus": [
      {
        "id": "ftpUpload.explorerMenu",
        "label": "%submenu.explorerMenu.label%"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ftpUpload.remoteFiles",
          "name": "%view.remoteFiles.name%"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "submenu": "ftpUpload.explorerMenu",
          "when": "resourceScheme == file",
          "group": "7_ftpUpload"
        }
      ],
      "ftpUpload.explorerMenu": [
        {
          "command": "ftpUpload.uploadToServer",
          "group": "1_transfer@1"
        },
        {
          "command": "ftpUpload.downloadFromServer",
          "group": "1_transfer@2"
        },
        {
          "command": "ftpUpload.configureFolder",
          "when": "explorerResourceIsFolder",
          "group": "2_setup@1"
        }
      ],
      "view/title": [
        {
          "command": "ftpUpload.refreshRemoteFiles",
          "when": "view == ftpUpload.remoteFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ftpUpload.downloadRemote",
          "when": "view == ftpUpload.remoteFiles && viewItem =~ /^ftp/",
          "group": "inline@1"
        },
        {
          "command": "ftpUpload.downloadRemote",
          "when": "view == ftpUpload.remoteFiles && viewItem =~ /^ftp/",
          "group": "7_ftpActions@1"
        },
        {
          "command": "ftpUpload.deleteRemote",
          "when": "view == ftpUpload.remoteFiles && viewItem =~ /^ftp/",
          "group": "inline@2"
        },
        {
          "command": "ftpUpload.deleteRemote",
          "when": "view == ftpUpload.remoteFiles && viewItem =~ /^ftp/",
          "group": "7_ftpActions@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ftpUpload.openRemoteFile",
          "when": "false"
        },
        {
          "command": "ftpUpload.downloadRemote",
          "when": "false"
        },
        {
          "command": "ftpUpload.deleteRemote",
          "when": "false"
        },
        {
          "command": "ftpUpload.downloadFromServer",
          "when": "false"
        },
        {
          "command": "ftpUpload.uploadToServer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "ftpUpload.configFile": {
          "type": "string",
          "default": ".vscode/ftp-sync.json",
          "description": "%config.configFile.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "minimatch": "^9.0.4"
  }
}
